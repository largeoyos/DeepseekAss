        "aliases": [],
        "traits": [
          {
            "value": "三十二岁，水文测绘员，坚持证据胜于传闻。未在本章出场。",
            "source_chapter": 1,
            "source_version": 1
          },
          {
            "value": "三十二岁，水文测绘员。短发，袖口卷到小臂。坚持证据胜于传闻。工作严谨，用铁夹子压图纸，用尺子比曲线。面对冲突时冷静，趁乱保存关键证据。",
            "source_chapter": 2,
            "source_version": 1
          }
        ],
        "status": [
          {
            "value": "alive",
            "source_chapter": 1,
            "source_version": 1
          },
          {
            "value": "alive",
            "source_chapter": 2,
            "source_version": 1
          }
        ],
        "importance": [
          {
            "value": "normal",
            "source_chapter": 1,
            "source_version": 1
          },
          {
            "value": "major",
            "source_chapter": 2,
            "source_version": 1
          }
        ],
        "key_details": [
          {
            "value": "是个女人，短发，袖口卷到小臂，手里捏着铅笔，正拿尺子比一条曲线。",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“我叫叶青，水文测绘。这卷是旧码头拆除前的复核数据。”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "叶青拿过信，对着灯看了一遍，又放回原处。",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "叶青趁这一下，把最上面几页抽出来，卷成筒，塞进自己的测绘筒，拧上盖。",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "叶青把测绘筒背到肩上，过来扶他",
            "source_chapter": 2,
            "source_version": 1
          }
        ],
        "key_dialogues": [
          {
            "value": "“旧信。”她把铅笔搁下，“哪一年的？”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“不是差一点。”叶青说，“是差一整段。报告里那天夜里最高水位一米八，我这份原始记录，同一时段是两米七。”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“这不是誊错。”她说，“誊错会整行重抄。这是刮掉一格，填一格。而且——”她把纸翻过来，对着灯，“背面没有透墨。刮的时候纸已经干透了，说明改的时间，离抄写有段日子，但在这份报告归档之前。”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“知道。”叶青说，“但改的人是谁，这份复印件上看不出来。原件在港务档案室，我调不出来。”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“我的数据，我收着。”",
            "source_chapter": 2,
            "source_version": 1
          },
          {
            "value": "“十年前那件事，报告我核过。数据不对，我就想知道数据为什么不对。别的我不掺和。”",
            "source_chapter": 2,
            "source_version": 1
          }
        ],
